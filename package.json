    "bump:patch": "node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.9",
    "jsdom": "^26.1.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
